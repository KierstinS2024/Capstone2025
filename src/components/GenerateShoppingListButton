"use client";

import React from "react";
import styles from "../styles/shoppingList.module.css";

interface Props {
  planId: string;
}

export default function GenerateShoppingListButton({ planId }: Props) {
  const handleGenerate = async () => {
    await fetch(`/api/shopping-lists/from-meal-plan`, {
      method: "POST",
      body: JSON.stringify({ planId }),
      headers: { "Content-Type": "application/json" },
    });
    alert("Shopping list updated from this meal plan.");
  };

  return (
    <button onClick={handleGenerate} className={styles.generateBtn}>
      Generate Shopping List from this Plan
    </button>
  );
}
