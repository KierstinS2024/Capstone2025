# ============================
# Recipe & Meal Planner App
# Environment Variables Example
# ============================

# ----------------------------
# MongoDB connection string
# ----------------------------
# Format:
# mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
# Replace the placeholders with your MongoDB Atlas credentials
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.example.mongodb.net/your_database

# ----------------------------
# JWT secret
# ----------------------------
# Used to sign JSON Web Tokens for authentication.
# Use a strong, random string (e.g., 32+ characters)
JWT_SECRET=your_jwt_secret_here

# ----------------------------
# Spoonacular API key
# ----------------------------
# Public API key for accessing Spoonacular recipe and nutrition data
# Sign up at https://spoonacular.com/food-api to get your own key
NEXT_PUBLIC_SPOONACULAR_API_KEY=your_spoonacular_api_key_here
